# .env.local로 복사해서 채웁니다. .env.local은 커밋되지 않습니다.

# Supabase 프로젝트 주소. 경로 없이 https://<프로젝트 ref>.supabase.co 형태 (/rest/v1/ 붙이지 않기)
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys
# Publishable key (sb_publishable_...). 예전 프로젝트라면 anon key도 동작합니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 1부터 사용 (서버 전용, 절대 NEXT_PUBLIC_ 접두사를 붙이지 않습니다)
OPENROUTER_API_KEY=
# 생성형 LLM (Claim 추출) — OpenRouter 모델 id. eval 재현성을 위해 버전을 고정 (예: z-ai/glm-5.3-flash)
LLM_MODEL=
# 판정 모델 — 버전 고정
JEV_MODEL=typesafe/jev-1.13
# 임베딩 모델 (기존 Action 매칭). 1536차원이어야 한다 (actions.embedding). 비우면 openai/text-embedding-3-small
EMBEDDING_MODEL=
# 보낼 공급자 고정 (OpenRouter 공급자 slug, 쉼표로 구분, 이 순서로만 · 다른 공급자로 넘어가지 않음). 처리방침: 미국 소재 · ZDR 공급자만.
# 비우면 기본값 (src/lib/ai/providers.ts). 모델을 바꾸면 그 모델의 ZDR 공급자로 함께 바꾼다.
# 기본: LLM fireworks,together,deepinfra · 임베딩 azure · Jev typesafe
LLM_PROVIDERS=
EMBED_PROVIDERS=
JEV_PROVIDERS=

# ── 연동 (Notion 등) · 서버 전용 ──
# Supabase → Project Settings → API Keys → service_role (RLS를 우회하므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 않습니다)
SUPABASE_SERVICE_ROLE_KEY=
# 연동 토큰 암호화 키: openssl rand -base64 32
CONNECTOR_TOKEN_KEY=
# 주기 동기화(/api/cron/sync) 호출 비밀값: openssl rand -hex 32. Vercel Cron은 Authorization: Bearer 로 보냅니다.
CRON_SECRET=
# Notion 공개 연결(public connection): https://www.notion.so/profile/integrations 에서 만든 값
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# 로컬: http://localhost:3000/api/connectors/notion/callback (Notion에 같은 주소를 Redirect URI로 등록)
NOTION_REDIRECT_URI=
# 앱에서 연결할 때 쓰는 서명된 OAuth state(HMAC-SHA256)의 키: openssl rand -hex 32 (32자 이상)
OAUTH_STATE_SECRET=
# Slack 앱 (docs/go-live/slack-app.md): api.slack.com/apps → Taskforce(로컬은 Taskforce dev) → Basic Information → App Credentials
# Client ID는 숫자.숫자 모양입니다 (앱 ID A…가 아닙니다)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack이 보낸 이벤트의 서명 확인 (/api/connectors/slack/events). 없으면 이벤트를 받지 않습니다
SLACK_SIGNING_SECRET=
# 로컬: 터널 주소 + /api/connectors/slack/callback (Slack 앱의 Redirect URL과 글자까지 같게)
SLACK_REDIRECT_URI=
# (선택) 앱 수준 토큰 xapp-… (권한 authorizations:read). 한 워크스페이스에 이용자가 둘 이상일 때만 필요합니다
SLACK_APP_TOKEN=
# 앱에 Slack 연결을 여는가: true · false. 비우면 개발 서버에서만 엽니다. 운영은 처리방침 · 앱 문구를 맞춘 뒤 true로
SLACK_CONNECT_ENABLED=

# ── 알림 (APNs) · 서버 전용, Phase A3에서 발급 ──
# Apple Developer → Keys → Apple Push Notifications service 키 (.p8). 줄바꿈은 \n으로 적습니다.
APNS_KEY_ID=
APNS_TEAM_ID=U9DWQKQFMW
APNS_PRIVATE_KEY=
# 비우면 dev.taskforcelabs.taskforce
APNS_BUNDLE_ID=

# ── 계정 삭제 시 Sign in with Apple 토큰 폐기 · 서버 전용 ──
# Apple Developer → Keys → Sign in with Apple을 켠 키 (.p8, APNs 키와 같은 키여도 됨). 줄바꿈은 \n으로 적습니다.
# 비워 두면 폐기를 건너뛰고(로그만) 계정 삭제는 그대로 합니다.
APPLE_TEAM_ID=U9DWQKQFMW
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 앱 번들 id (Sign in with Apple client_id). 비우면 dev.taskforcelabs.taskforce
APPLE_CLIENT_ID=

# 관리자 지표(/admin/metrics)를 볼 수 있는 이메일 (쉼표로 구분)
ADMIN_EMAILS=

# 주간 질문 "Taskforce 밖에 따로 적어둔 할 일이 있나요?" (지표 5). 비우면 켜짐, 베타가 끝나면 false로 끕니다
WEEKLY_CHECK_ENABLED=

# ── App Store 심사 계정 · scripts/create-review-account.ts에서만 (서버 env에 두지 않아도 됨) ──
# 이 주소만 이메일 + 비밀번호로 가입할 수 있다 (review_accounts + Before User Created 훅). 비밀번호는 12자 이상.
REVIEW_ACCOUNT_EMAIL=
REVIEW_ACCOUNT_PASSWORD=
