# .env.local로 복사해서 채웁니다. .env.local은 커밋되지 않습니다.

# Supabase 프로젝트 주소. 경로 없이 https://<프로젝트 ref>.supabase.co 형태 (/rest/v1/ 붙이지 않기)
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys
# Publishable key (sb_publishable_...). 예전 프로젝트라면 anon key도 동작합니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 1부터 사용 (서버 전용, 절대 NEXT_PUBLIC_ 접두사를 붙이지 않습니다)
OPENROUTER_API_KEY=
# 생성형 LLM (Claim 추출) — OpenRouter 모델 id. eval 재현성을 위해 버전을 고정 (예: z-ai/glm-5.3-flash)
LLM_MODEL=
# 판정 모델 — 버전 고정
JEV_MODEL=typesafe/jev-1.13
