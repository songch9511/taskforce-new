// Release 빌드(TestFlight · App Store)만. Base(+ Secrets)를 그대로 쓰고 서버 주소 · Google 로그인 클라이언트만 운영 값으로 고정한다.
// Debug는 Secrets.xcconfig의 API_BASE_URL(로컬 서버 등) · GOOGLE_IOS_*(선택)를 그대로 쓴다. Supabase URL · 키는 두 설정 모두 Secrets에서 온다.
// xcconfig에서 "//"는 주석이라 URL의 "//"를 "/$()/"로 적는다.
#include "Base.xcconfig"

API_BASE_URL = https:/$()/api.taskforcelabs.dev

// Sign in with Google: 프로젝트 A(taskforce-510108)의 iOS 클라이언트 "Taskforce app sign-in (iOS · Mac)".
// 앱 Info.plist에 그대로 들어가는 공개 식별자(비밀 없음)라 커밋한다. 아카이브하는 Mac의 Secrets에 값이 빠져도
// TestFlight 빌드에서 Google 버튼이 조용히 사라지지 않게 여기서 고정한다. 운영 Supabase → Google 제공자의 Client IDs와 같은 값이다.
GOOGLE_IOS_CLIENT_ID = 923900348266-iopmhbf1foor213n1jc3a8tv6v4fti82.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.923900348266-iopmhbf1foor213n1jc3a8tv6v4fti82

// Sign in with Apple (Mac, 브라우저 창 로그인): Developer ID 앱은 앱 안 Apple 로그인을 쓸 수 없어(권한을 받지 못한다) Apple 웹 로그인을 한다.
// Services ID는 Primary App ID(dev.taskforcelabs.taskforce)에 묶인 것이고, Return URL은 서버 중계 route다 (`/api/v1/apple/return`).
// 둘 다 앱 Info.plist에 그대로 들어가는 공개 값(비밀 없음)이라 커밋한다. 운영 Supabase → Apple 제공자의 Client IDs에도 이 Services ID가 있어야 한다.
// 서버 route가 먼저 배포돼 있어야 한다 (docs/go-live/mac-dmg.md "Apple 로그인").
APPLE_SERVICES_ID = dev.taskforcelabs.taskforce.signin
APPLE_WEB_RETURN_URL = https:/$()/api.taskforcelabs.dev/api/v1/apple/return

// 자동 업데이트(Sparkle). *** 출시 전 채울 것 *** 둘 중 하나라도 비어 있으면 앱은 업데이터를 시작하지 않고 메뉴 "Check for Updates…"는 꺼져 있다.
// 둘 다 공개 값이라 커밋한다 (EdDSA 개인 키는 사용자 Keychain에만 있다). 만드는 법 · 올리는 법: docs/go-live/mac-dmg.md "자동 업데이트".
//   SPARKLE_FEED_URL      = appcast.xml의 HTTPS 주소. 위처럼 "//"는 "/$()/"로: https:/$()/<호스트>/<경로>/appcast.xml
//   SPARKLE_PUBLIC_ED_KEY = Sparkle generate_keys가 출력한 공개 키(base64, 32바이트). 값에 "//"가 들어 있으면 그 자리도 "/$()/"로
SPARKLE_FEED_URL =
SPARKLE_PUBLIC_ED_KEY =

// Mac bridge (OA D2b): Release도 기본 꺼짐. 켜는 것(L5)은 이 줄을 YES로 바꾸는 것이다 (Base.xcconfig).
TF_BRIDGE_ENABLED = NO

// 이메일 6자리 코드 로그인 입구 (OA 이메일 로그인): Release는 꺼진 채로 낸다 (Base.xcconfig는 Debug용 YES).
// 여는 날(법률 게시 · Resend 도메인 확인과 Pro 전환 · 훅 마이그레이션 적용이 끝난 날) 이 줄을 YES로 바꾸는 한 줄 PR을 낸다.
// NO면 로그인 화면의 이메일 입구 · Settings의 Email 줄 · 이메일 계정의 Add가 없다 (지금 모양 그대로).
EMAIL_SIGN_IN_ENABLED = NO
