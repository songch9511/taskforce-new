// 이 파일을 Secrets.xcconfig로 복사해 값을 채웁니다. Secrets.xcconfig는 커밋되지 않습니다.
//   cp apple/Config/Secrets.example.xcconfig apple/Config/Secrets.xcconfig
//
// xcconfig에서 "//"는 주석이라 URL의 "//"를 "/$()/"로 적어야 합니다.
// 값은 웹의 .env.local과 같습니다 (NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).

SUPABASE_URL = https:/$()/<프로젝트 ref>.supabase.co
SUPABASE_KEY = sb_publishable_...

// Taskforce 서버 주소 (경로 없이). 시뮬레이터에서 로컬 서버(npm run dev)를 쓰려면 http:/$()/localhost:3000
API_BASE_URL = https:/$()/<서버 주소>

// Sign in with Google (선택). Google Cloud 프로젝트 A → Clients의 iOS 클라이언트(Mac도 같은 값)와 그 화면의 "iOS URL scheme".
// 비워 두면 로그인 화면에 Google 버튼이 나오지 않고 나머지는 그대로 된다. Release 빌드는 Release.xcconfig의 값을 쓴다.
//   GOOGLE_IOS_CLIENT_ID = <숫자>-<문자>.apps.googleusercontent.com
//   GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.<숫자>-<문자>
GOOGLE_IOS_CLIENT_ID =
GOOGLE_IOS_URL_SCHEME =

// Sign in with Apple (선택, Mac 브라우저 창 로그인). Apple Developer → Identifiers → Services IDs에서 만든 값과 그 Return URL (서버의 /api/v1/apple/return).
// 비워 두면 로그인 화면에 Apple 버튼이 나오지 않고 나머지는 그대로 된다. Release 빌드는 Release.xcconfig의 값을 쓴다.
// 로컬 서버로는 시험할 수 없다: Apple은 Return URL로 도메인(https)만 받는다 (운영 주소의 route를 그대로 쓴다. route는 상태가 없다).
//   APPLE_SERVICES_ID = dev.taskforcelabs.taskforce.signin
//   APPLE_WEB_RETURN_URL = https:/$()/<서버 주소>/api/v1/apple/return
APPLE_SERVICES_ID =
APPLE_WEB_RETURN_URL =
