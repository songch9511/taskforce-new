// 이 파일을 Secrets.xcconfig로 복사해 값을 채웁니다. Secrets.xcconfig는 커밋되지 않습니다.
//   cp apple/Config/Secrets.example.xcconfig apple/Config/Secrets.xcconfig
//
// xcconfig에서 "//"는 주석이라 URL의 "//"를 "/$()/"로 적어야 합니다.
// 값은 웹의 .env.local과 같습니다 (NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).

SUPABASE_URL = https:/$()/<프로젝트 ref>.supabase.co
SUPABASE_KEY = sb_publishable_...
